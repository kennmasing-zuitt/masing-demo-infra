name: kisetsu-scheduler-server
services:
    app:
        image: ${images["kisetsu-scheduler-server"]}
        container_name: kisetsu-scheduler-server
        restart: unless-stopped
        env_file: .env
        environment:
            NODE_ENV: production
            PORT: 2200
            MONGO_URI: $${DOCKER_MONGO_URI:?set DOCKER_MONGO_URI (Atlas) in .env}
            CORS_ORIGINS: $${DOCKER_CORS_ORIGINS:-https://scheduling.masings.com}
            TRUST_PROXY: 1
        networks:
            default:
            web:
                aliases: [kisetsu-scheduler-server]
networks:
    web:
        external: true # shared with the Nginx proxy
